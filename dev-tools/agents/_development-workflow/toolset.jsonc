{
  "development-workflow-tools": {
    "supabase": ["execute_query", "run_migration", "deploy_function"],
    "github": ["create_pull_request", "list_workflow_runs", "create_issue"],
    "playwright": ["run_suite", "screenshot_capture", "trace_analysis"],
    "react-devtools": ["inspect_component", "profile_render"],
    "utility": [
      "fetch",
      "fs_read",
      "fs_write",
      "git_status",
      "time_now",
      "time_convert"
    ]
  },
  "playwright": {
    "runTests": "npx playwright test",
    "runTestsHeaded": "npx playwright test --headed",
    "runTestsUI": "npx playwright test --ui",
    "generateTest": "npx playwright codegen",
    "showReport": "npx playwright show-report"
  },
  // Context7 auto-invocation rules for code, setup, and documentation requests
  "context7_rules": [
    {
      "when": [
        "code generation",
        "setup",
        "configuration",
        "library docs",
        "API docs"
      ],
      "then": "use context7"
    }
  ]
}
