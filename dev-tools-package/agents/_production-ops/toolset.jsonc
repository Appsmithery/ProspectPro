{
  "production-ops-mcp": {
    "tools": [
      "github.create_pull_request",
      "github.merge_pull_request",
      "supabase.validate_migration",
      "supabase.check_pool_health",
      "supabase.execute_query",
      "supabase_troubleshooting.correlate_errors",
      "supabase_troubleshooting.generate_incident_timeline",
      "utility.fetch",
      "utility.fs_read",
      "utility.fs_write",
      "utility.git_status",
      "utility.time_now",
      "utility.time_convert"
    ],
    "description": "Canonical production operations tools for deployment, incident response, and database health.",
    "icon": "build"
  },
  "playwright": {
    "runTests": "npx playwright test",
    "runTestsHeaded": "npx playwright test --headed",
    "runTestsUI": "npx playwright test --ui",
    "generateTest": "npx playwright codegen",
    "showReport": "npx playwright show-report"
  },
  "observability": {
    "highlight": {
      "projectId": "kgr09vng",
      "enabled": true,
      "environment": "production",
      "features": {
        "errorTracking": true,
        "sessionReplay": false,
        "performanceMonitoring": true
      }
    },
    "opentelemetry": {
      "endpoint": "http://localhost:4318/v1/traces",
      "serviceName": "production-ops-agent"
    }
  },
  "context7_rules": [
    {
      "when": [
        "code generation",
        "setup",
        "configuration",
        "library docs",
        "API docs"
      ],
      "then": "use context7"
    }
  ]
}
