{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "composite": false,
    "incremental": false,
    
    /* Path mapping for workspace structure */
    "baseUrl": ".",
    "paths": {
      "@frontend/*": ["app/frontend/src/*"],
      "@backend/*": ["app/backend/*"],
      "@shared/*": ["app/shared/*"],
      "@dev-tools/*": ["dev-tools/*"]
    }
  },
  "files": [],
  "include": [],
  "exclude": [
    "node_modules",
    "dist",
    ".deno_lsp",
    ".task",
    "playwright-report",
    "test-results",
    "**/node_modules/**",
    "**/dist/**"
  ]
}

